---
import Section from "../Section.astro";
import { basics } from "@cv";
import panda  from "../../img/panda.jpg";
const { summary } = basics;
---

<Section id="sobremi" title="Sobre mí">
  <div class="content_aboutme">
    <div class="title_aboutme">
      <h1>Practica, esfuerzo y actitud, pueden ayudarte con un bug.</h1>
    </div>
    <div class="summary">
      <div class="boxPic" id="panda">
        <img class="picPanda" src={panda.src} alt="">
      </div>
      <p>
        {summary}
      </p>
    </div>
  </div>
</Section>

<style>
  .content_aboutme {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
    height: 800px;
  }

  .title_aboutme {
    display: flex;
    align-items: flex-start;

    width: 350px;
    flex-shrink: 0;
  }

  .summary {
    display: block;
    text-align: right;
    width: 900px;
  }

  h1 {
    font-family: "Arimo", sans-serif;
    font-weight: 400;

    font-size: clamp(1.8rem, 3vw, 2.5rem);
    width: 100%;

    color: var(--txt-color);
  }

  p {
    font-family: "Arimo", sans-serif;
    font-size: clamp(1rem, 2vw, 1.5rem);
    font-weight: 100;
    text-wrap: pretty;
    color: var(--txt-color);
  }

  /* 📱 RESPONSIVE */
  @media (max-width: 900px) {
    .content_aboutme {
      flex-direction: column;
      justify-content: flex-start;
      align-items: flex-start;
      height: 100%;
    }

    .title_aboutme {
      width: 100%;
    }

    h1 {
      text-align: center;
    }

    .summary {
      width: 100%;
      justify-content: flex-start;
      text-align: center;
      align-items: flex-start;
    }
  }

  .boxPic {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 600px;

    transform: scale(1);
    transition: transform 0.1s linear;
  }

  .picPanda {
    width: 300px;
  }

  #panda {
    transition: transform 0.15s ease-out
  }
</style>

<script>

  const box = document.querySelector('#panda');

window.addEventListener('scroll', () => {
  if (!box) return;

  const rect = box.getBoundingClientRect();
  const windowHeight = window.innerHeight;

  const elementCenter = rect.top + rect.height / 2;
  const screenCenter = windowHeight / 2;

  const distance = Math.abs(elementCenter - screenCenter);

  const progress = Math.min(
    distance / (windowHeight / 2),
    1
  );

  const scale = 1.3 - progress * 0.5;

  box.style.transform = `scale(${scale})`;
});
  
</script>
