---
import { basics } from "@cv";
import Section from "@/components/Section.astro";

const { profiles } = basics;
---

<Section id="presentation">
  <div class="container">
    <div class="eslogan">
      <div class="container_eslogan">
        <h1>Hola soy David, desarrollador de software</h1>
        <div class="lenguajes_collagues">
          <img
            class="big"
            src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/java/java-original.svg"
          />
          <img
            class="medium"
            src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/python/python-original.svg"
          />
          <img
            class="small-node"
            src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/nodejs/nodejs-original-wordmark.svg"
          />
          <img
            class="small-springboot"
            src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/spring/spring-original.svg"
          />
        </div>
      </div>
    </div>
    <div class="section_profiles_description">
      <div class="profiles">
        {
          profiles.map(({ network, url }) => {
            return (
              <a
                href={url}
                title={`Visitar ${network}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                {network}
              </a>
            );
          })
        }
      </div>
      <div class="description">
        <p>
          Conocimientos fundamentales y gran interés en el desarrollo de
          aplicaciones y soluciones tecnológicas, junto a un equipo.
        </p>
      </div>
    </div>
  </div>
</Section>

<style>
  h1 {
    font-family: "Noto Serif JP", sans-serif;
    font-weight: 500;
    font-size: clamp(2rem, 5vw, 4.5rem);
    line-height: 1.2;
    width: 60%;
    color: var(--txt-color);
    margin: 0;
  }

  p {
    margin: 0;
    font-size: clamp(1rem, 2vw, 1.5rem);
    font-family: "Arimo", sans-serif;
    color: var(--txt-color);
    line-height: 1.6;
  }

  .eslogan {
    display: flex;
    margin-top: 60px;
  }

  .container_eslogan {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    width: 100%;
  }

  .lenguajes_collagues {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    grid-auto-rows: 90px;
    gap: 15px;
    padding: 20px;
  }

  .lenguajes_collagues img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 15px;
  }

  .big {
    grid-column: span 3;
    grid-row: span 3;
  }

  .medium {
    grid-column: span 2;
    grid-row: span 2;
  }

  .small-node,
  .small-springboot {
    grid-column: span 1;
    grid-row: span 1;
  }

  .section_profiles_description {
    display: flex;
    gap: 2rem;
    align-items: flex-end;
    justify-content: space-between;
    margin-top: 2rem;
  }

  .profiles {
    display: flex;
    gap: 2rem;
    flex: 1;
    flex-wrap: wrap;
    align-items: center;
  }

  .profiles a {
    font-family: "Arimo", sans-serif;
    font-weight: 0.9rem;
    color: #777;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    background-color: var(--bg-a-color);
    border: 1px solid var(--border-color);

    padding: 4px;
    height: 30px;
    width: 80px;

    border-radius: 20px;
    text-decoration: none;
    transition: color 0.3s ease
      background 0.3s ease
      border-color 0.3s ease
      transform 0.3s ease;
  }

  .profiles a:hover {
    color: var(--txt-color);
    background: var(--bg-a-color);
    border-color: var(--txt-color);
    transform: translateY(-3px);
  }

  .description {
    display: flex;
    flex-direction: column;
    text-align: right;
    width: 60%;
  }

  @media (min-width: 767px) and (max-width: 1023px) {
    h1 {
      width: 80%;
      text-align: center;
      margin: 0 auto;
    }

    .container_eslogan {
      gap: 20px;
    }
    
    .section_profiles_description {
      gap: 1.5rem;
      align-items: center;
    }

    .profiles {
      gap: 1rem;
    }

    .profiles a {
      width: 70px;
      font-size: 0.8rem;
    }

    .description {
      width: 55%;
    }


    .lenguajes_collagues {
      display: grid
      grid-template-columns: repeat(4, minmax(0px, 1fr));
      grid-auto-rows: minmax(110px, auto);
      gap: 12px;
      padding: 15px;
    }

    .big,
    .medium,
    .small-node,
    .small-springboot {
      grid-column: span 1;
      grid-row: span 1;
    }

    .lenguajes_collagues img {
      width: 100%;
      height: 100%;
      max-height: 150px;
      object-fit: contain;
      border-radius: 12px;
    }
  }

  @media (max-width: 767px) {

    h1 {
      width: 90%;
      margin: 0 auto;
      text-align: center;
      font-size: clamp(2rem, 8vw, 2.8rem);
      line-height: 1.2;
    }

    p {
      font-size: 1rem;
      line-height: 1.7;
    }

    .eslogan {
      margin-top: 30px;
      justify-content: center;
    }

    .container_eslogan {
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 25px;
    }

    .section_profiles_description {
      flex-direction: column;
      align-items: center;
      gap: 25px;
      margin-top: 1.5rem;
      padding: 0 15px;
    }

    .profile {
      width: 100%;
      justify-content: center;
      align-items: center;
      gap: 12px;
    }

    .profiles a {
      width: 85px;
      height: 34px;
      font-size: 0.8rem;
    }

    .description {
      width: 100%;
      text-align: center;
      align-items: center;
    }

    .lenguajes_collagues {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: minmax(110px, auto);
      gap: 15px;
      padding: 15px;
      width: 100%;
      box-sizing: border-box;
    }

    .big,
    .medium,
    .small-node,
    .small-springboot {
      grid-column: span 1;
      grid-row: span 1;
    }


    .lenguajes_collagues > * {
      display: flex;
      align-items: center;
      justify-content: center;
      
      min-width: 0;
      min-height: 110px;
      padding: 15px;

      background: var(--bg-a-color);
      border: 1px solid var(--border-color);
      border-radius: 16px;

      box-sizing: border-box;

      transition: 
        transform 0.25s ease
        box-shadow 0.25s ease;
    }

    .lenguajes_collagues img {
      width: 100%;
      height: 100%;
      
      object-fit: contain;
      border-radius: 12px;
    }

    .lenguajes_collagues > *:active {
      transform: scale(0.95);
    }
  }

  @media (hover: hover) and (min-width: 768px) {
    .lenguajes_collagues > * {
      transition: 
      tranform 0.25s ease
      box-shadow 0.25s ease;
    }

    .lenguajes_collagues > *:hover {
      transform: translateY(-5px)
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .profile a, 
    .lenguajes_collagues > *,
    .lenguajes_collagues img {
      transition: none;
    }
  }
</style>
